import seaborn as sns
import matplotlib.pyplot as plt


sns.set_theme()


print(sns.get_dataset_names())


tips=sns.load_dataset("tips")
tips.head()


sns.set_theme(style="ticks")

sns.relplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="sex",
    size="size",
    style="sex"
)


# scatter plot

tips=sns.load_dataset("tips")

sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="time"
)


sns.lineplot(
    data=tips,
    x="total_bill",
    y="tip",
)


#barplot

sns.barplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex"
)


#box plot

sns.boxplot(
    data=tips,
    x="day",
    y="total_bill",
)


#histrogram

penguins=sns.load_dataset("penguins")

sns.histplot(
    data=penguins,
    x="body_mass_g",
    bins=30
)


