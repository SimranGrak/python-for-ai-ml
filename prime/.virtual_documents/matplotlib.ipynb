# histogram
import numpy as np

np.random.seed(0)

scores=np.random.normal(70, 10, 1000)

plt.hist(scores, color="pink", edgecolor="black", bins=10)
plt.axvline(
    x=33,
    label="passing marks",
    color="red",
    linestyle="--",
    linewidth=2
)

plt.title("range of scores")
plt.xlabel("scores")
plt.ylabel("students")


# Multiple datasets
legit_transactions = [
    2.99, 5.49, 8.99, 12.50, 14.99, 19.99, 23.45, 29.99, 34.99, 39.50,
    45.00, 49.99, 55.25, 60.00, 75.99, 89.99, 120.50, 150.00, 199.99,
    249.99, 300.75, 450.00, 600.00, 850.00, 1200.00
]

