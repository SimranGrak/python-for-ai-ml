# 2 bar charts
import numpy as np

movies = [
    "The Dark Knight", 
    "The Hurt Locker",  
    "The King's Speech", 
    "The Artist",     
    "Argo"
]
years = [2008, 2009, 2010, 2011, 2012]
oscar_revenue = [1005, 170, 427, 133, 232]  # in $M

non_oscar_movies = [
    "Slumdog Millionaire",
    "Avatar","Inception",
    "Hugo","Lincoln"
]
years = [2008, 2009, 2010, 2011, 2012]
non_oscar_revenue = [378, 2788, 829, 185, 275]  # in $M

x=np.arange(len(years))
width=0.4

plt.bar(x-width/2,oscar_revenue, width, label="oscar_revenue")                #shifting to LEFT
plt.bar(x+width/2,non_oscar_revenue,width, label="non_oscar_revenue")         #shifting to RIGHT

plt.title("oscar vs non-oscar movies revenue")
plt.xlabel("years")
plt.ylabel("revenue in $M")
plt.legend()
plt.xticks(x,years)


# 3 bar charts

import numpy as np

movies = [
    "The Dark Knight", 
    "The Hurt Locker",  
    "The King's Speech", 
    "The Artist",     
    "Argo"
]
years = [2008, 2009, 2010, 2011, 2012]
oscar_revenue = [1005, 170, 427, 133, 232]  # in $M

non_oscar_movies = [
    "Slumdog Millionaire",
    "Avatar","Inception",
    "Hugo","Lincoln"
]
years = [2008, 2009, 2010, 2011, 2012]
non_oscar_revenue = [378, 2788, 829, 185, 275]  # in $M

x=np.arange(len(years))
width=0.2

plt.bar(x-width,oscar_revenue, width, label="oscar_revenue")                #shifting to LEFT
plt.bar(x,non_oscar_revenue,width, label="non_oscar_revenue")         #shifting to RIGHT
plt.bar(x+width,oscar_revenue, width, label="oscar_revenue")      

plt.title("oscar vs non-oscar movies revenue")
plt.xlabel("years")
plt.ylabel("revenue in $M")
plt.legend()
plt.xticks(x,years)


