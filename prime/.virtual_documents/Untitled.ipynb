





import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns


np.random.seed(0)

data=np.random.normal(70, 10, 200)

plt.hist(data, bins=15, edgecolor="black")

average=np.mean(data)

plt.axvline(
    x=average,
    label="average marks",
    linewidth=2,
    linestyle="--",
    color="red"
)

plt.title("number frequency")
plt.xlabel("numbers range")
plt.ylabel("frequency")
plt.tight_layout()






penguins=sns.load_dataset("penguins")

sns.relplot(
    data=penguins,
    x="flipper_length_mm",
    y="body_mass_g",
    hue="species"
)





tips=sns.load_dataset("tips")

sns.boxplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex"
)

highest_median=tips.groupby("day")["total_bill"].median()
print(highest_median)

print("day with maximum median:", highest_median.idxmax())





tips=sns.load_dataset("tips")

sns.relplot(
    data=tips,
    x="tip",
    y="total_bill",
    hue="smoker",
    style="sex"
)

plt.title("total_bill vs tips")





